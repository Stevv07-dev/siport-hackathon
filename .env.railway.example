# ---------------------------------------------------------------------------
# Variabel environment untuk service web MAXPORT di Railway.
#
# Bukan file yang dibaca otomatis oleh entrypoint — ini referensi untuk
# ditempel ke Railway Dashboard (Service → Variables → Raw Editor) atau lewat
# `railway variables --set`. Lihat DEPLOYMENT.md §5 untuk urutan langkahnya.
#
# JANGAN commit versi terisi dari file ini.
# ---------------------------------------------------------------------------

APP_NAME=MAXPORT
APP_ENV=production
APP_KEY=                                  # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# --- Database — variable reference ke service MySQL Railway ----------------
DB_CONNECTION=mysql
DB_HOST=${{MySQL.MYSQLHOST}}
DB_PORT=${{MySQL.MYSQLPORT}}
DB_DATABASE=${{MySQL.MYSQLDATABASE}}
DB_USERNAME=${{MySQL.MYSQLUSER}}
DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}

# --- Sesi & antrean ----------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
# Kosongkan — domain *.up.railway.app tidak butuh SESSION_DOMAIN eksplisit,
# dan salah isi ini adalah penyebab paling umum "419 Page Expired".
SESSION_DOMAIN=

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Railway ada di belakang proxy edge-nya sendiri; percayai semuanya supaya
# APP_URL yang dihasilkan Laravel tetap https://.
TRUSTED_PROXIES=*

# Railway tidak punya service "setup" terpisah — migrasi dijalankan saat
# service web start.
RUN_MIGRATIONS_ON_START=true

# --- Email -------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Login Google (opsional) — tombol "Google" hanya tampil bila diisi ------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# --- reCAPTCHA v2 (opsional) — widget di login/register hanya tampil bila
# CAPTCHA_SITE_KEY diisi; verifikasi server-side no-op tanpa SECRET_KEY.
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# --- Product Screening (compliance engine) ----------------------------------
# "backend_ai" (default, offline, tanpa API key, hanya USB-C Cable), "gemini",
# atau "anthropic".
COMPLIANCE_ENGINE=backend_ai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
