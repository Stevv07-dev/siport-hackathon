# ---------------------------------------------------------------------------
# Konfigurasi container untuk docker-compose.yml (lokal / staging).
# Salin ke .env.docker lalu sesuaikan.
#
# APP_KEY dibuat sekali dengan:
#   docker compose run --rm --entrypoint php app artisan key:generate --show
# ---------------------------------------------------------------------------

APP_NAME=MAXPORT
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Port yang diterbitkan ke host
APP_PORT=8080
DB_PUBLISHED_PORT=3307

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# DB_HOST diisi otomatis oleh compose (service "mysql")
DB_CONNECTION=mysql
DB_PORT=3306
DB_DATABASE=maxport_db
DB_USERNAME=maxport
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=root-change-me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@maxport.local"
MAIL_FROM_NAME="${APP_NAME}"

# Login Google (opsional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# reCAPTCHA v2 (opsional) — widget di login/register hanya tampil kalau SITE_KEY diisi.
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# Mesin kuisioner & verdict Product Screening — "backend_ai" (default, offline,
# tanpa API key, hanya USB-C Cable), "gemini" (butuh GEMINI_API_KEY), atau
# "anthropic" (butuh ANTHROPIC_API_KEY).
COMPLIANCE_ENGINE=backend_ai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Perilaku entrypoint "setup"
SETUP_RUN_MIGRATE=true
SETUP_RUN_SEED=false
SETUP_RUN_STORAGE_LINK=true
